{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataDir": "data",
  "Backup": {
    "Keep": 14,
    "Hour": 3
  },
  "Inventory": {
    "ExpiringSoonDays": 3,
    "FreezeWindowDays": 2,
    "FreezerWarnRatio": 0.8
  }
}
